{
  "name": "aegis-full-product",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node --import ./scripts/environment.mjs ./node_modules/next/dist/bin/next dev --hostname 127.0.0.1",
    "build": "node --import ./scripts/environment.mjs ./node_modules/next/dist/bin/next build",
    "start": "node --import ./scripts/environment.mjs ./node_modules/next/dist/bin/next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write app components lib tests *.ts *.json",
    "format:check": "prettier --check app components lib tests *.ts *.json",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3"
  }
}
