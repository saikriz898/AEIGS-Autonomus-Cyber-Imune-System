# Generate actual local secrets using: py scripts/configure.py
# These values are placeholders; there is no default owner account/password.
AEGIS_COMPOSE_PROJECT=aegis-full-product
POSTGRES_USER=aegis
POSTGRES_DB=aegis
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_RANDOM_LOCAL_PASSWORD
SETUP_TOKEN=CHANGE_ME_GENERATE_RANDOM_SETUP_TOKEN
SESSION_TTL_HOURS=12
ALLOW_SELF_REGISTRATION=true
COOKIE_SECURE=false
FRONTEND_PORT=3000
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://api:8000
DATASET_ROOTS=/datasets/unsw,/datasets/iot,/datasets/ton,/datasets/phishing,/datasets/local,/storage/uploads
LOCAL_DATA_PATH=./data/raw
# Optional host bind-mount overrides; these resolve relative to full-product/.
UNSW_DATA_PATH=./data/raw/archive
IOT_DATA_PATH=./data/raw/archive (1)
TON_DATA_PATH=./data/raw/archive (2)
PHISHING_DATA_PATH=./data/raw/archive (3)
STORAGE_ROOT=/storage
MAX_UPLOAD_BYTES=52428800
MAX_DATASET_ROWS=50000
WORKER_CONCURRENCY=1
WORKER_MAX_MEMORY_KB=1200000
CODE_VERSION=local-development
# none | openai | local. Optional: never required for startup.
AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=
LOCAL_AI_BASE_URL=
LOCAL_AI_MODEL=
LOCAL_AI_TIMEOUT_SECONDS=90
LOCAL_AI_MAX_TOKENS=450
# Optional CPU model service: COMPOSE_PROFILES=local-ai, AI_PROVIDER=local,
# LOCAL_AI_BASE_URL=http://local-model:11434/v1, LOCAL_AI_MODEL=qwen2.5:1.5b.
# Pull the model explicitly; startup never downloads weights automatically.
COMPOSE_PROFILES=
OLLAMA_IMAGE=ollama/ollama:latest
NVD_API_KEY=
INTEGRATION_NETWORK_ENABLED=false
